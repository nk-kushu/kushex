FROM node:24-bookworm-slim
RUN apt-get update \
    && apt-get install --yes --no-install-recommends bubblewrap ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global tsx@4.23.15
USER node
WORKDIR /source/kushex
ENV TSX_TSCONFIG_PATH=plugins/coding/tsconfig.json
CMD ["node", "--import", "/usr/local/lib/node_modules/tsx/dist/loader.mjs", "--test", "plugins/coding/tests/CodingAgent.test.ts"]
