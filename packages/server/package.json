{
  "name": "@kushex/server",
  "version": "0.0.0",
  "private": true,
  "description": "Kushex Node.js server.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:status": "prisma migrate status",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "test:integration": "prisma generate && vitest run --dir tests/integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "fastify": "^5.12.0",
    "joi": "^18.1.0",
    "pino": "^10.0.0",
    "prisma": "~7.10.1",
    "zod": "^4.6.0",
    "@kushex/contracts": "workspace:*",
    "tsx": "^4.23.15",
    "pg": "^8.23.0",
    "kushibot": "file:../../../kushibot"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
