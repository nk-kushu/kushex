// Kushex application tables. Kushibot framework stores own their `kushibot_*` tables
// and are not modelled here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["kushex"]
}

model Project {
  id          String     @id @default(uuid()) @db.Uuid
  actorId     String
  name        String     @db.VarChar(200)
  description String?    @db.VarChar(2000)
  createdAt   DateTime   @default(now())
  workspace   Workspace?

  @@index([actorId, createdAt, id])
  @@schema("kushex")
}

model Workspace {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @db.Uuid
  path      String  @db.VarChar(4096)
  branch    String?
  revision  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("kushex")
}

// Settings belong to the request actor, independently of projects and panel instances.
enum ColorMode {
  system
  light
  dark

  @@schema("kushex")
}

enum Density {
  comfortable
  compact

  @@schema("kushex")
}

model UserSettings {
  actorId   String    @id
  colorMode ColorMode @default(system)
  density   Density   @default(comfortable)
  /// Splitter id → panel fractions; PATCH merges by id.
  splitterSizes Json  @default("{}")
  updatedAt DateTime  @updatedAt

  @@schema("kushex")
}
