{
  "name": "kushex",
  "private": true,
  "type": "module",
  "description": "Kushex harness panel monorepo.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @kushex/standalone dev",
    "changeset": "changeset",
    "typecheck:agent:coding": "tsc -p plugins/coding/tsconfig.json",
    "test:agent:coding": "TSX_TSCONFIG_PATH=plugins/coding/tsconfig.json node --import ./packages/server/node_modules/tsx/dist/loader.mjs --test plugins/coding/tests/CodingAgent.test.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "joi": "^18.1.0"
  }
}
